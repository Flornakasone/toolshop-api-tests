        {
          "name": "Register - throwaway user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = pm.variables.replaceIn(\"{{$timestamp}}\");\npm.collectionVariables.set(\"throwaway_email\", `qa${stamp}@doe.example`);\n\n// Random password: unique each run, meets complexity rules, unlikely to be in a leak database\nconst rand = (len, chars) => Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join(\"\");\nconst password = [\n  rand(4, \"ABCDEFGHJKLMNPQRSTUVWXYZ\"),\n  rand(4, \"abcdefghijkmnopqrstuvwxyz\"),\n  rand(4, \"23456789\"),\n  rand(2, \"!@#$%^&*\"),\n  stamp\n].join(\"\");\npm.collectionVariables.set(\"throwaway_password\", password);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  " pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Response contains the created user's email\", function () {\n  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get(\"throwaway_email\"));\n});\n\npm.test(\"Response contains a user id\", function () {\n  pm.expect(pm.response.json()).to.have.property(\"id\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
