    {
      "name": "Products",
      "item": [
        {
          "name": "All products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { \n    pm.response.to.have.status(200); \n});\n\npm.test(\"Response time is less than 2000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(2000); \n});\n\nconst jsonData = pm.response.json();\n\npm.test(\"Returns a non-empty product list\", function () {\n    pm.expect(jsonData.data).to.be.an(\"array\");\n    pm.expect(jsonData.data.length).to.be.above(0);\n});\n\nconst product_id = jsonData.data[0].id;\n\npm.collectionVariables.set(\"product_id\", product_id);\n\npm.test(\"Every product has an id and a name\", () => {\n  jsonData.data.forEach(p => {\n    pm.expect(p).to.have.property(\"id\");\n    pm.expect(p).to.have.property(\"name\");\n  });\n});\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "by_brand",
                  "value": "string",
                  "disabled": true
                },
                {
                  "key": "by_category",
                  "value": "string",
                  "disabled": true
                },
                {
                  "key": "is_rental",
                  "value": "string",
                  "disabled": true
                },
